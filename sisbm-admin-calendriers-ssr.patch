@@ -19,32 +19,59 @@ const STEPS = [
 
 export const HEAT_LEVELS = STEPS.length - 1;
 
-/** Clés stables des paliers : les bornes se confondent quand la vue est toute à zéro. */
-const LEVEL_KEYS = ["p1", "p2", "p3", "p4", "p5"] as const;
