+    onSuccess: invalidate,
+  });
+}
+
+export function useDetachDriverGroup() {
+  const invalidate = useInvalidateDrivers();
+  return useMutation({
+    mutationFn: ({ id, groupId }: { id: string; groupId: string }) => driverService.detachGroup(id, groupId),
+    onSuccess: invalidate,
+  });
+}
