@@ -0,0 +1,115 @@
+"use client";
+
+import { useMemo } from "react";
+
+import { useRouter } from "next/navigation";
+
+import { Info, RefreshCw } from "lucide-react";
+
+import { PageHeader } from "@shared/components/page-header";
+import { useAccess } from "@shared/components/providers/access-provider";
+import { ErrorState } from "@shared/components/query-state";
+import { Alert, AlertDescription } from "@shared/components/ui/alert";
+import { Badge } from "@shared/components/ui/badge";
+import { Button } from "@shared/components/ui/button";
+import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@shared/components/ui/card";
+import { ScrollArea } from "@shared/components/ui/scroll-area";
+import { LiveFleetCard } from "@shared/features/common/live/live-fleet-card";
+import { FleetAlerts } from "@shared/features/fleet/fleet-alerts";
+import { FleetKpis } from "@shared/features/fleet/fleet-kpis";
+import { deriveAlerts } from "@shared/features/fleet/fleet-state";
+import { OperatorVehicles } from "@shared/features/home-operator/operator-vehicles";
+import { ActivityChart } from "@shared/features/home-platform/activity-chart";
+import { useAdminActivity } from "@shared/hooks/api/use-admin";
+import { useFleet } from "@shared/hooks/api/use-fleet";
+import { useLiveVehicles } from "@shared/hooks/use-live-vehicles";
+
+/**
+ * Tableau de bord NIVEAU 3 — opérateur, client final.
+ *
+ * Même socle que le tableau de bord principal (carte, KPI de flotte, courbes
+ * d'activité), recentré sur le SUIVI : la flotte de l'organisation en temps
+ * réel, ses alertes, et la sécurité des véhicules. Aucune création
+ * d'utilisateur, de tracker, de flotte ni de véhicule — ni ici, ni dans le
+ * menu (cf. `operatorSidebarItems`), et l'API les refuse de toute façon.
+ */
+export function OperatorDashboard() {
+  const router = useRouter();
+  const { organizationName, user } = useAccess();
+
+  const fleet = useFleet();
+  const vehicles = useLiveVehicles(fleet.vehicles);
+  const activity = useAdminActivity({ days: 7 });
+  const alerts = useMemo(() => deriveAlerts(vehicles), [vehicles]);
+
+  const firstName = user?.fullName.split(" ")[0];
+
+  return (
+    <div className="@container/main flex flex-col gap-4 md:gap-6">
+      <PageHeader
+        title={firstName ? `Bonjour ${firstName}` : "Mon espace"}
+        description={
+          organizationName ? (
+            <>
+              Suivi en temps réel des véhicules de{" "}
+              <span className="font-medium text-foreground">{organizationName}</span>
+            </>
+          ) : (
+            "Suivi en temps réel de vos véhicules"
+          )
+        }
+        actions={
+          <Button variant="outline" size="sm" onClick={fleet.refetch} disabled={fleet.isFetching}>
+            <RefreshCw data-icon="inline-start" className={fleet.isFetching ? "animate-spin" : undefined} />
+            Actualiser
+          </Button>
+        }
+      />
+
+      {fleet.isError ? (
+        <ErrorState error={fleet.error} onRetry={fleet.refetch} />
+      ) : (
+        <>
+          <FleetKpis vehicles={vehicles} total={fleet.total} loading={fleet.isPending} />
+
+          <div className="grid gap-4 md:gap-6 xl:grid-cols-[minmax(0,1fr)_360px]">
+            <LiveFleetCard vehicles={vehicles} loading={fleet.isPending} title="Mes véhicules en direct" />
+
+            <Card className="min-h-0 gap-3">
+              <CardHeader>
+                <CardTitle className="flex items-center gap-2">
+                  Alertes en direct
+                  <Badge variant={alerts.length > 0 ? "destructive" : "secondary"} className="rounded-full">
+                    {alerts.length}
+                  </Badge>
+                </CardTitle>
+                <CardDescription>Survitesse, perte de signal, moteur tournant à l'arrêt</CardDescription>
+              </CardHeader>
+              <CardContent className="min-h-0 flex-1 px-0">
+                <ScrollArea className="h-[440px]">
+                  <div className="px-4 pb-2">
+                    <FleetAlerts alerts={alerts} onSelect={(id) => router.push(`/dashboard/fleet?vehicle=${id}`)} />
+                  </div>
+                </ScrollArea>
+              </CardContent>
+            </Card>
+          </div>
+
+          <OperatorVehicles vehicles={vehicles} loading={fleet.isPending} />
+
+          <div className="rounded-xl bg-[#0E508D] shadow-xl">
+            <ActivityChart days={activity.data?.days} loading={activity.isPending} />
+          </div>
+
+          <Alert>
+            <Info className="size-4" />
+            <AlertDescription>
+              Besoin d'un nouveau véhicule, d'un tracker, d'une flotte ou d'un compte ? Ces opérations sont réservées à
+              l'administrateur de votre organisation.
+            </AlertDescription>
+          </Alert>
+        </>
+      )}
+    </div>
+  );
+}
diff --git a/packages/shared/src/features/home-operator/operator-vehicles.tsx b/packages/shared/src/features/home-operator/operator-vehicles.tsx
new file mode 100644
index 0000000..b2fdb15
--- /dev/null
+++ b/packages/shared/src/features/home-operator/operator-vehicles.tsx
@@ -0,0 +1,150 @@
+"use client";
+
+import { useMemo, useState } from "react";
+
+import Link from "next/link";
+
+import { MapPinned, Search } from "lucide-react";
+
+import { useAccess } from "@shared/components/providers/access-provider";
+import { EmptyState, LoadingRows } from "@shared/components/query-state";
+import { StatusBadge } from "@shared/components/status-badge";
+import { Button } from "@shared/components/ui/button";
+import { Card, CardAction, CardContent, CardDescription, CardHeader, CardTitle } from "@shared/components/ui/card";
+import { InputGroup, InputGroupAddon, InputGroupInput } from "@shared/components/ui/input-group";
+import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@shared/components/ui/table";
+import { SecurityActions } from "@shared/features/common/commands/security-actions";
+import { FLEET_STATE_META, fleetState } from "@shared/features/fleet/fleet-state";
+import { formatDateTime, formatNumber, formatRelative, toNumber } from "@shared/lib/format";
+import type { VehicleDetail } from "@shared/types/vehicle";
+
+/** Ordre d'affichage : ce qui demande une attention d'abord. */
+const STATE_RANK = { alert: 0, moving: 1, idle: 2, stopped: 3, offline: 4, unknown: 5 } as const;
+
+/**
+ * Mes véhicules — consultation et sécurité.
+ *
+ * Aucune action de gestion (création, modification, montage) : seulement le
+ * suivi et la coupure / le rétablissement du carburant, que l'opérateur
+ * détient (`command:immobilize`) et que l'API contrôle (vitesse, fraîcheur
+ * de position, traçabilité).
+ */
+export function OperatorVehicles({ vehicles, loading }: { vehicles: VehicleDetail[]; loading: boolean }) {
+  const { can } = useAccess();
+  const [search, setSearch] = useState("");
+  const canImmobilize = can("command:immobilize");
+
+  const rows = useMemo(() => {
+    const q = search.trim().toLowerCase();
+    return vehicles
+      .filter((v) => !q || v.registration.toLowerCase().includes(q) || (v.label ?? "").toLowerCase().includes(q))
+      .map((v) => ({ v, state: fleetState(v) }))
+      .sort((a, b) => STATE_RANK[a.state] - STATE_RANK[b.state] || a.v.registration.localeCompare(b.v.registration));
+  }, [vehicles, search]);
+
+  return (
+    <Card>
+      <CardHeader>
+        <CardTitle>Mes véhicules</CardTitle>
+        <CardDescription>Ordonnés par priorité : survitesse, déplacement, arrêt, hors ligne</CardDescription>
+        <CardAction>
+          <InputGroup className="w-56">
+            <InputGroupInput
+              placeholder="Immatriculation…"
+              value={search}
+              onChange={(e) => setSearch(e.target.value)}
+              aria-label="Rechercher un véhicule"
+            />
+            <InputGroupAddon>
+              <Search />
+            </InputGroupAddon>
+          </InputGroup>
+        </CardAction>
+      </CardHeader>
+      <CardContent className="px-0">
+        {loading ? (
+          <LoadingRows rows={6} />
+        ) : rows.length === 0 ? (
+          <div className="px-6">
+            <EmptyState
+              title={search ? "Aucun résultat" : "Aucun véhicule"}
+              description={
+                search
+                  ? "Aucun véhicule ne correspond à cette recherche."
+                  : "Votre administrateur n'a pas encore rattaché de véhicule à votre organisation."
+              }
+            />
+          </div>
+        ) : (
+          <Table>
+            <TableHeader>
+              <TableRow>
+                <TableHead className="pl-6">Véhicule</TableHead>
+                <TableHead>État</TableHead>
+                <TableHead className="text-right">Vitesse</TableHead>
+                <TableHead className="hidden md:table-cell">Dernière position</TableHead>
+                <TableHead className="pr-6 text-right">Actions</TableHead>
+              </TableRow>
+            </TableHeader>
+            <TableBody>
+              {rows.map(({ v, state }) => {
+                const meta = FLEET_STATE_META[state];
+                const speed = toNumber(v.lastPosition?.speedKph);
+                const limit = toNumber(v.speedLimitKph);
+                return (
+                  <TableRow key={v.id}>
+                    <TableCell className="pl-6">
+                      <Link
+                        href={`/dashboard/vehicles/${v.id}`}
+                        prefetch={false}
+                        className="flex flex-col font-medium hover:underline"
+                      >
+                        {v.registration}
+                        <span className="font-normal text-muted-foreground text-xs">
+                          {[v.brand, v.model].filter(Boolean).join(" ") || v.label || "—"}
+                        </span>
+                      </Link>
+                    </TableCell>
+                    <TableCell>
+                      <StatusBadge tone={meta.tone}>{meta.label}</StatusBadge>
+                    </TableCell>
+                    <TableCell className="text-right tabular-nums">
+                      {speed === null ? "—" : `${formatNumber(Math.round(speed))} km/h`}
+                      {limit ? (
+                        <span className="block text-muted-foreground text-xs">limite {formatNumber(limit)}</span>
+                      ) : null}
+                    </TableCell>
+                    <TableCell
+                      className="hidden text-muted-foreground md:table-cell"
+                      title={formatDateTime(v.lastPosition?.recordedAt)}
+                    >
+                      {v.lastPosition ? formatRelative(v.lastPosition.recordedAt) : "Aucune position"}
+                    </TableCell>
+                    <TableCell className="pr-6">
+                      <div className="flex flex-wrap justify-end gap-2">
+                        <Button size="sm" variant="outline" asChild>
+                          <Link href={`/dashboard/fleet/${v.id}`} prefetch={false}>
+                            <MapPinned data-icon="inline-start" />
+                            Suivre
+                          </Link>
+                        </Button>
+                        {canImmobilize ? (
+                          <SecurityActions
+                            vehicleId={v.id}
+                            deviceId={v.device?.id}
+                            hasRelay={v.device?.hasRelay ?? false}
+                            immobilizationEnabled={v.immobilizationEnabled}
+                          />
+                        ) : null}
+                      </div>
+                    </TableCell>
+                  </TableRow>
+                );
+              })}
+            </TableBody>
+          </Table>
+        )}
+      </CardContent>
+    </Card>
+  );
+}
