+NEXT_PUBLIC_URL=https://api.sisbm-core.com
+
+# Adresses publiques des trois espaces : un compte qui se trompe d'espace y est renvoyé.
+NEXT_PUBLIC_SUPERADMIN_APP_URL=https://superadmin.sisbm-core.com
+NEXT_PUBLIC_ADMIN_APP_URL=https://admin.sisbm-core.com
+NEXT_PUBLIC_CLIENT_APP_URL=https://app.sisbm-core.com
