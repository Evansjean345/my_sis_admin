{
  "name": "sisbm-core-dashboards",
  "version": "2.2.0",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:superadmin": "npm run dev -w @sisbm/superadmin",
    "dev:admin": "npm run dev -w @sisbm/admin",
    "dev:client": "npm run dev -w @sisbm/client",
    "build": "npm run build -w @sisbm/superadmin && npm run build -w @sisbm/admin && npm run build -w @sisbm/client",
    "build:superadmin": "npm run build -w @sisbm/superadmin",
    "build:admin": "npm run build -w @sisbm/admin",
    "build:client": "npm run build -w @sisbm/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "prepare": "husky",
    "generate:presets": "npm run generate:presets -w @sisbm/shared"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": ["biome check --write --no-errors-on-unmatched"]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.1.5",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
